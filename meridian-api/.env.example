# Copy to .env and use only an approved synthetic-data model gateway.
LITELLM_BASE_URL=https://genailab.tcs.in/v1
LITELLM_API_KEY=replace-with-approved-key
PRIMARY_MODEL=gemini-2.5-flash-lite
FALLBACK_MODEL=genailab-maas-gpt-4o
LLM_REQUEST_TIMEOUT=10
LLM_GENERATION_TIMEOUT=22
SSL_VERIFY=true
RESET_DB_ON_START=0
MERIDIAN_AS_OF_DATE=2026-10-08
DEMO_AUTH_ENABLED=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
